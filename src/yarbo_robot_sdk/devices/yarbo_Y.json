{
  "version": "1.1",
  "type_id": "yarbo_Y",
  "name": "Yarbo Y Series",
  "topics": [
    {
      "name": "device_msg",
      "template": "snowbot/{sn}/device/DeviceMSG",
      "description": "Device real-time status push"
    },
    {
      "name": "heart_beat",
      "template": "snowbot/{sn}/device/heart_beat",
      "description": "Device heartbeat status"
    },
    {
      "name": "data_feedback",
      "template": "snowbot/{sn}/device/data_feedback",
      "description": "Device command response feedback"
    }
  ],
  "apis": [
    {
      "name": "device_detail",
      "method": "GET",
      "path_template": "/devices/{sn}",
      "description": "Device detail"
    }
  ],
  "control_topics": [
    {
      "name": "set_working_state",
      "template": "snowbot/{sn}/app/set_working_state",
      "description": "Set device working state"
    },
    {
      "name": "read_gps_ref",
      "template": "snowbot/{sn}/app/read_gps_ref",
      "description": "Request GPS reference origin"
    },
    {
      "name": "get_map",
      "template": "snowbot/{sn}/app/get_map",
      "description": "Request map/zone data"
    },
    {
      "name": "read_all_plan",
      "template": "snowbot/{sn}/app/read_all_plan",
      "description": "Request all auto plans"
    },
    {
      "name": "get_device_msg",
      "template": "snowbot/{sn}/app/get_device_msg",
      "description": "Request full DeviceMSG snapshot"
    },
    {
      "name": "get_connect_wifi_name",
      "template": "snowbot/{sn}/app/get_connect_wifi_name",
      "description": "Request connected Wi-Fi information"
    },
    {
      "name": "start_plan",
      "template": "snowbot/{sn}/app/start_plan",
      "description": "Start an auto plan"
    },
    {
      "name": "pause",
      "template": "snowbot/{sn}/app/pause",
      "description": "Pause current plan"
    },
    {
      "name": "resume",
      "template": "snowbot/{sn}/app/resume",
      "description": "Resume paused plan"
    },
    {
      "name": "stop",
      "template": "snowbot/{sn}/app/stop",
      "description": "Stop current plan"
    },
    {
      "name": "cmd_recharge",
      "template": "snowbot/{sn}/app/cmd_recharge",
      "description": "Return to charging station"
    },
    {
      "name": "set_sound_param",
      "template": "snowbot/{sn}/app/set_sound_param",
      "description": "Set sound parameters"
    },
    {
      "name": "light_ctrl",
      "template": "snowbot/{sn}/app/light_ctrl",
      "description": "Control head light"
    },
    {
      "name": "set_person_detect",
      "template": "snowbot/{sn}/app/set_person_detect",
      "description": "Set person detection"
    },
    {
      "name": "set_follow_state",
      "template": "snowbot/{sn}/app/set_follow_state",
      "description": "Set follow mode"
    },
    {
      "name": "save_global_params",
      "template": "snowbot/{sn}/app/save_global_params",
      "description": "Save global parameters"
    },
    {
      "name": "set_map_obstacle_switch",
      "template": "snowbot/{sn}/app/set_map_obstacle_switch",
      "description": "Set map obstacle switch"
    },
    {
      "name": "ignore_obstacles",
      "template": "snowbot/{sn}/app/ignore_obstacles",
      "description": "Ignore obstacle zones"
    },
    {
      "name": "set_child_lock",
      "template": "snowbot/{sn}/app/set_child_lock",
      "description": "Set child lock"
    },
    {
      "name": "song_cmd",
      "template": "snowbot/{sn}/app/song_cmd",
      "description": "Play device sound"
    },
    {
      "name": "wireless_charging_cmd",
      "template": "snowbot/{sn}/app/wireless_charging_cmd",
      "description": "Wireless charging control"
    },
    {
      "name": "mower_target_cmd",
      "template": "snowbot/{sn}/app/mower_target_cmd",
      "description": "Set mower blade target height"
    },
    {
      "name": "mower_speed_cmd",
      "template": "snowbot/{sn}/app/mower_speed_cmd",
      "description": "Set mower blade speed"
    },
    {
      "name": "cmd_set_chute_angle",
      "template": "snowbot/{sn}/app/cmd_set_chute_angle",
      "description": "Set snow chute angle"
    }
  ],
  "control_fields": [
    {
      "path": "HeartBeatMSG.working_state",
      "name": "Working State",
      "entity_type": "select",
      "command_topic": "set_working_state",
      "command_key": "state",
      "options": [
        "standby",
        "working"
      ],
      "value_map": {
        "standby": 0,
        "working": 1
      },
      "state_value_map": {
        "0": "standby",
        "1": "working"
      },
      "extra_payload": {
        "source": "smart_home"
      },
      "icon": "mdi:play-pause",
      "category": "control"
    },
    {
      "path": "StateMSG.enable_sound",
      "name": "Sound Switch",
      "entity_type": "switch",
      "command_topic": "set_sound_param",
      "command_builder": "sound_switch",
      "icon": "mdi:volume-high",
      "category": "sound"
    },
    {
      "path": "StateMSG.volume",
      "name": "Volume",
      "entity_type": "number",
      "command_topic": "set_sound_param",
      "command_builder": "sound_volume",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "icon": "mdi:volume-medium",
      "category": "sound"
    },
    {
      "path": "MowerState.blade_height",
      "name": "Blade Height",
      "entity_type": "number",
      "command_topic": "mower_target_cmd",
      "command_key": "target",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "mm",
      "icon": "mdi:arrow-up-down",
      "enabled_by_default": false,
      "category": "mower",
      "compatible_head_types": [3, 5]
    },
    {
      "path": "MowerState.blade_speed",
      "name": "Blade Speed",
      "entity_type": "number",
      "command_topic": "mower_speed_cmd",
      "command_key": "state",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "icon": "mdi:speedometer",
      "enabled_by_default": false,
      "category": "mower",
      "compatible_head_types": [3, 5]
    },
    {
      "path": "RunningStatusMSG.chute_angle",
      "name": "Chute Angle",
      "entity_type": "number",
      "command_topic": "cmd_set_chute_angle",
      "command_key": "cmd",
      "min": 0,
      "max": 180,
      "step": 1,
      "unit": "°",
      "icon": "mdi:angle-acute",
      "enabled_by_default": false,
      "category": "snow",
      "compatible_head_types": [1]
    },
    {
      "path": "LedInfoMSG.led_head",
      "name": "Head Light",
      "entity_type": "switch",
      "command_topic": "light_ctrl",
      "command_builder": "light_switch",
      "icon": "mdi:car-light-high",
      "category": "light"
    },
    {
      "path": "StateMSG.person_detect_status",
      "name": "Person Detection",
      "entity_type": "switch",
      "command_topic": "set_person_detect",
      "command_builder": "person_detection_switch",
      "icon": "mdi:account-search",
      "enabled_by_default": false,
      "category": "safety"
    },
    {
      "path": "StateMSG.robot_follow_state",
      "name": "Follow Mode",
      "entity_type": "switch",
      "command_topic": "set_follow_state",
      "command_builder": "state_int_switch",
      "icon": "mdi:account-arrow-right",
      "enabled_by_default": false,
      "category": "control"
    },
    {
      "path": "enable_elec_fence",
      "name": "Geo Fence",
      "entity_type": "switch",
      "command_topic": "save_global_params",
      "command_builder": "geo_fence_switch",
      "icon": "mdi:fence",
      "enabled_by_default": false,
      "category": "safety"
    },
    {
      "path": "map_obstacle_switch",
      "name": "Ignore Obstacles",
      "entity_type": "switch",
      "command_topic": "set_map_obstacle_switch",
      "command_builder": "ignore_obstacles_switch",
      "icon": "mdi:map-marker-off",
      "enabled_by_default": false,
      "category": "safety"
    },
    {
      "path": "StateMSG.child_lock_status",
      "name": "Child Lock",
      "entity_type": "switch",
      "command_topic": "set_child_lock",
      "command_builder": "state_bool_switch",
      "icon": "mdi:lock",
      "category": "safety"
    },
    {
      "path": "__action__.ignore_obstacle_zones",
      "name": "Ignore Obstacle Zones",
      "entity_type": "button",
      "command_topic": "ignore_obstacles",
      "command_builder": "ignore_obstacle_zones",
      "icon": "mdi:map-marker-remove",
      "enabled_by_default": false,
      "category": "safety"
    },
    {
      "path": "__action__.play_sound",
      "name": "Play Sound",
      "entity_type": "button",
      "command_topic": "song_cmd",
      "command_builder": "play_sound",
      "icon": "mdi:volume-source",
      "category": "sound"
    },
    {
      "path": "__action__.emergency_stop",
      "name": "Emergency Stop",
      "entity_type": "button",
      "command_topic": "stop",
      "command_builder": "empty_payload",
      "icon": "mdi:octagon",
      "category": "safety"
    }
  ],
